---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="My Profile - Posty ✨">
  <style is:global>
    body {
      overflow-y: auto !important;
      height: auto !important;
      min-height: 100vh !important;
      overscroll-behavior-y: auto !important;
    }
  </style>

  <div class="min-h-screen bg-[#f0fdf4] text-gray-800 font-quicksand pb-36">
    <div class="max-w-md mx-auto p-4 sm:p-6">
      
      <!-- Top Navigation -->
      <header class="flex items-center justify-between pb-4 border-b border-emerald-100">
        <a href={baseUrl} class="w-9 h-9 rounded-full bg-white border border-emerald-100 shadow-sm flex items-center justify-center text-emerald-600 hover:scale-105 active:scale-95 transition">
          <i class="fas fa-arrow-left text-sm"></i>
        </a>
        <h1 class="text-base font-extrabold text-emerald-900">My Profile ✨</h1>
        <button id="saveTopBtn" class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white px-4 py-1.5 rounded-full text-xs font-bold shadow-md shadow-emerald-200 hover:scale-105 active:scale-95 transition">
          Save
        </button>
      </header>

      <!-- GOOGLE SIGN IN CARD (Sirf Logout hone par dikhega) -->
      <div id="loginPromptCard" class="cute-card p-5 mt-4 border border-emerald-200 bg-gradient-to-br from-emerald-50 to-teal-50 text-center shadow-sm">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-2 shadow-sm border border-emerald-100">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-6 h-6" alt="Google" />
        </div>
        <h2 class="text-sm font-bold text-emerald-950">Google se Login Karein</h2>
        <p class="text-[11px] text-emerald-700/80 mb-3 mt-0.5">Apna naam, photo aur Mobile No cloud par save rakhne ke liye login karein.</p>
        <button id="googleLoginBtn" type="button" class="w-full py-2.5 px-4 bg-white hover:bg-gray-50 border border-gray-200 rounded-xl shadow-sm flex items-center justify-center gap-2 text-xs font-bold text-gray-700 active:scale-95 transition cursor-pointer">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="G" />
          <span id="googleLoginBtnText">Continue with Google</span>
        </button>
      </div>

      <!-- Profile Avatar & Details Card -->
      <div class="cute-card p-5 mt-4 border border-emerald-100">
        
        <!-- Avatar Section -->
        <div class="flex flex-col items-center mb-4">
          <div class="relative cursor-pointer group" onclick="document.getElementById('profilePicInput').click()" title="Photo Badlein">
            <img id="profileAvatar" class="w-20 h-20 rounded-full object-cover border-4 border-white shadow-md bg-white" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Guest" alt="Avatar" />
            <div class="absolute bottom-0 right-0 bg-emerald-500 text-white rounded-full p-1.5 shadow-md border-2 border-white">
              <i class="fas fa-camera text-[10px]"></i>
            </div>
            <button type="button" id="cropTriggerBtn" class="absolute bottom-0 -left-1 bg-white text-emerald-600 shadow-md rounded-full w-7 h-7 flex items-center justify-center border border-emerald-100 hover:bg-emerald-50 transition" title="Adjust / Crop Photo">
              <i class="fas fa-crop text-xs"></i>
            </button>
          </div>
          <input type="file" id="profilePicInput" accept="image/*" class="hidden" />

          <!-- Logged in Google Email & Plan Badge -->
          <div class="text-center mt-2">
            <span id="planBadge" class="inline-flex items-center gap-1 bg-gray-100 text-gray-500 text-[10px] font-bold px-2.5 py-0.5 rounded-full mb-1">
              Logged Out
            </span>
            <p id="userEmailText" class="text-xs text-gray-400 font-mono">Not Logged In</p>
          </div>
        </div>

        <!-- Form Fields -->
        <div class="space-y-3">
          <div>
            <label class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider block mb-1">Your Name</label>
            <input type="text" id="nameInput" class="w-full px-3.5 py-2.5 rounded-xl bg-emerald-50/50 border border-emerald-100 text-sm font-bold text-emerald-900 outline-none focus:ring-2 focus:ring-emerald-300 transition" placeholder="Aapka Naam" oninput="this.value = this.value.replace(/\b\w/g, c => c.toUpperCase())" />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider block mb-1">Profession / Kaam</label>
              <input type="text" id="professionInput" class="w-full px-3 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 text-xs text-emerald-800 outline-none focus:ring-2 focus:ring-emerald-300 transition" placeholder="e.g. Graphic Designer" />
            </div>
            <div>
              <label class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider block mb-1">WhatsApp / Mobile</label>
              <input type="tel" id="contactInput" class="w-full px-3 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 text-xs text-emerald-800 outline-none focus:ring-2 focus:ring-emerald-300 transition" placeholder="Mobile No." />
            </div>
          </div>

          <!-- Follow Me Toggle -->
          <div class="flex items-center justify-between p-2.5 bg-emerald-50/40 rounded-xl border border-emerald-100/60 mt-1">
            <label class="text-xs font-bold text-emerald-800 flex items-center gap-1.5">
              <i class="fas fa-users text-emerald-500"></i> Posters par 'Follow Me' dikhayein
            </label>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="socialsToggle" class="sr-only peer" checked />
              <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
            </label>
          </div>

          <!-- Social Handles -->
          <div class="grid grid-cols-2 gap-2 pt-1">
            <div class="relative">
              <i class="fab fa-instagram absolute left-3 top-3 text-emerald-400 text-xs"></i>
              <input type="text" id="instaInput" class="w-full pl-8 pr-2 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 text-xs text-emerald-800 outline-none" placeholder="@insta" />
            </div>
            <div class="relative">
              <i class="fab fa-twitter absolute left-3 top-3 text-emerald-400 text-xs"></i>
              <input type="text" id="twitterInput" class="w-full pl-8 pr-2 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 text-xs text-emerald-800 outline-none" placeholder="@twitter" />
            </div>
            <div class="col-span-2 relative">
              <i class="fab fa-facebook-f absolute left-3 top-3 text-emerald-400 text-xs"></i>
              <input type="text" id="fbInput" class="w-full pl-8 pr-2 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 text-xs text-emerald-800 outline-none" placeholder="Facebook ID / Page" />
            </div>
          </div>
        </div>

        <button id="saveCardBtn" class="w-full mt-4 bg-gradient-to-r from-emerald-500 to-teal-500 text-white py-2.5 rounded-xl font-bold text-xs shadow-md shadow-emerald-200 active:scale-95 transition flex items-center justify-center gap-1.5">
          <i class="fas fa-check"></i> <span>Profile Changes Save Karein</span>
        </button>
      </div>

      <!-- Referrals / Pro Upgrade Card -->
      <div id="proPassCard" class="cute-card p-4 mt-4 border border-emerald-100 bg-gradient-to-br from-white to-emerald-50/40">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-sm">
              <i class="fas fa-crown"></i>
            </div>
            <div>
              <h3 class="text-xs font-bold text-emerald-950">Posty Pro Pass</h3>
              <p id="subExpiryInfo" class="text-[10px] text-gray-500">Login to view pass</p>
            </div>
          </div>
          <a href={`${baseUrl}?openPricing=true`} class="bg-gradient-to-r from-amber-500 to-rose-500 text-white px-3 py-1.5 rounded-xl text-[11px] font-bold shadow-sm hover:scale-105 active:scale-95 transition">
            View Pass
          </a>
        </div>
      </div>

      <!-- Danger & Account Actions (Sirf Logged-In User ke liye dikhega) -->
      <div id="accountSettingsCard" class="cute-card p-4 mt-4 border border-red-100 space-y-3 mb-10 hidden">
        <h4 class="text-[10px] font-bold uppercase tracking-wider text-gray-400 px-1">Account Settings</h4>
        
        <!-- Logout Button -->
        <button id="logoutBtn" type="button" class="w-full py-3 px-3.5 bg-gray-50 hover:bg-gray-100 text-gray-700 rounded-xl text-xs font-bold flex items-center justify-between border border-gray-200 active:scale-95 transition cursor-pointer">
          <span class="flex items-center gap-2">
            <i class="fas fa-sign-out-alt text-gray-400"></i> Account se Logout Karein
          </span>
          <i class="fas fa-chevron-right text-[10px] text-gray-400"></i>
        </button>

        <!-- Delete Account Button -->
        <button id="deleteBtn" type="button" class="w-full py-3 px-3.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-xl text-xs font-bold flex items-center justify-between border border-red-200 active:scale-95 transition cursor-pointer">
          <span class="flex items-center gap-2">
            <i class="fas fa-trash-alt text-red-500"></i> Apna Account Delete Karein
          </span>
          <span class="text-[9px] bg-red-200 text-red-800 font-extrabold px-2 py-0.5 rounded-full">Permanent</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Image Cropper Modal -->
  <div id="cropperModal" class="fixed inset-0 bg-black/80 z-[1100] hidden flex flex-col items-center justify-center p-4">
    <div class="bg-white rounded-[2rem] w-full max-w-xs h-[60vh] flex flex-col shadow-2xl relative overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-100 flex-shrink-0 bg-white z-10 text-center">
        <h3 class="text-emerald-600 font-bold text-sm">Adjust Photo</h3>
      </div>
      <div class="flex-1 bg-gray-50 relative w-full min-h-0 overflow-hidden p-6 flex items-center justify-center touch-none">
        <img id="imageToCrop" src="" class="max-w-full max-h-full block object-contain" crossorigin="anonymous" />
      </div>
      <div class="p-3 border-t border-gray-100 bg-white flex-shrink-0 z-10 flex gap-2">
        <button id="cropCancelBtn" type="button" class="flex-1 py-2 rounded-xl bg-gray-100 text-gray-500 font-bold text-xs">Skip</button>
        <button id="cropSaveBtn" type="button" class="flex-1 py-2 bg-emerald-500 text-white rounded-xl font-bold text-xs shadow-md">Save</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ baseUrl }}>
    // ⚠️ APNI APP.JS KI WORKING KEYS YAHAN DALEIN:
    const SUPABASE_URL = "https://wlxnxamlsqezpjsdyrah.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_Tvq6grbkSIsG1Doh7Y7Txw_t_cFm7BK"; 
    // ^ Agar aapne app.js me koi alag key dali hai, toh wahi key yahan paste karein!

    const DEFAULT_GUEST_AVATAR = "https://api.dicebear.com/7.x/avataaars/svg?seed=Guest";

    let sb = null;
    let cropper = null;
    let currentUser = null;

    let userState = {
      name: "",
      extra: "",
      contact: "",
      pic: DEFAULT_GUEST_AVATAR,
      socials: {
        visible: true,
        insta: { val: "", visible: true },
        twitter: { val: "", visible: true },
        fb: { val: "", visible: true }
      }
    };

    document.addEventListener('DOMContentLoaded', async () => {
      // 1. Supabase Initialization
      if (window.supabase) {
        sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        try {
          const { data: { session } } = await sb.auth.getSession();
          currentUser = session?.user || null;
          updateAuthUI(currentUser);
        } catch (e) {
          updateAuthUI(null);
        }

        sb.auth.onAuthStateChange((_event, session) => {
          currentUser = session?.user || null;
          updateAuthUI(currentUser);
        });
      } else {
        updateAuthUI(null);
      }

      // 2. Button Listeners
      document.getElementById('googleLoginBtn')?.addEventListener('click', handleGoogleLogin);
      document.getElementById('logoutBtn')?.addEventListener('click', handleLogout);
      document.getElementById('deleteBtn')?.addEventListener('click', handleDeleteAccount);
      document.getElementById('saveTopBtn')?.addEventListener('click', saveUserProfile);
      document.getElementById('saveCardBtn')?.addEventListener('click', saveUserProfile);
      document.getElementById('cropTriggerBtn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        initManualCrop();
      });
      document.getElementById('cropCancelBtn')?.addEventListener('click', cancelCrop);
      document.getElementById('cropSaveBtn')?.addEventListener('click', performCrop);
      document.getElementById('profilePicInput')?.addEventListener('change', handleFileSelect);
    });

    function updateAuthUI(user) {
      const loginCard = document.getElementById('loginPromptCard');
      const accountSettings = document.getElementById('accountSettingsCard');
      const emailText = document.getElementById('userEmailText');
      const badge = document.getElementById('planBadge');
      const subInfo = document.getElementById('subExpiryInfo');

      if (user) {
        // === LOGGED IN ===
        loginCard?.classList.add('hidden');
        accountSettings?.classList.remove('hidden');

        emailText.innerText = user.email || user.user_metadata?.full_name || user.user_metadata?.name || 'Google User';
        fetchPlanInfo(user.id);
        loadUserProfile(user);
      } else {
        // === LOGGED OUT ===
        loginCard?.classList.remove('hidden');
        accountSettings?.classList.add('hidden');

        emailText.innerText = "Not Logged In";
        badge.innerText = "Logged Out";
        badge.className = "inline-flex items-center gap-1 bg-gray-100 text-gray-500 text-[10px] font-bold px-2.5 py-0.5 rounded-full mb-1";
        if (subInfo) subInfo.innerText = "Login to activate or view Pro Pass";

        clearFormFields();
      }
    }

    function clearFormFields() {
      document.getElementById('nameInput').value = '';
      document.getElementById('professionInput').value = '';
      document.getElementById('contactInput').value = '';
      document.getElementById('profileAvatar').src = DEFAULT_GUEST_AVATAR;
      document.getElementById('socialsToggle').checked = true;
      document.getElementById('instaInput').value = '';
      document.getElementById('twitterInput').value = '';
      document.getElementById('fbInput').value = '';

      userState = {
        name: "",
        extra: "",
        contact: "",
        pic: DEFAULT_GUEST_AVATAR,
        socials: {
          visible: true,
          insta: { val: "", visible: true },
          twitter: { val: "", visible: true },
          fb: { val: "", visible: true }
        }
      };
    }

    function loadUserProfile(user) {
      const meta = user?.user_metadata || {};
      
      // 1. Local Storage Data
      const saved = localStorage.getItem('aestheticUser');
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          userState = { ...userState, ...parsed };
        } catch (e) {}
      }

      // 2. Google OAuth se aane wali saari possible keys check karein!
      const googleName = meta.custom_name || meta.full_name || meta.name || user.email?.split('@')[0] || '';
      const googlePic = meta.custom_pic || meta.avatar_url || meta.picture || '';
      const googleExtra = meta.custom_extra || meta.profession || '';
      const googleContact = meta.custom_contact || meta.phone || '';
      const googleSocials = meta.custom_socials || null;

      // Agar local me naam/photo nahi hai toh Google account se lein
      if (!userState.name && googleName) userState.name = googleName;
      if ((!userState.pic || userState.pic === DEFAULT_GUEST_AVATAR) && googlePic) userState.pic = googlePic;
      if (!userState.extra && googleExtra) userState.extra = googleExtra;
      if (!userState.contact && googleContact) userState.contact = googleContact;
      if (googleSocials && typeof googleSocials === 'object') userState.socials = { ...userState.socials, ...googleSocials };

      // 3. Form me show karein
      document.getElementById('nameInput').value = userState.name || '';
      document.getElementById('professionInput').value = userState.extra || '';
      document.getElementById('contactInput').value = userState.contact || '';
      document.getElementById('profileAvatar').src = userState.pic || DEFAULT_GUEST_AVATAR;

      const soc = userState.socials || {};
      document.getElementById('socialsToggle').checked = soc.visible !== undefined ? soc.visible : true;
      document.getElementById('instaInput').value = soc.insta?.val || '';
      document.getElementById('twitterInput').value = soc.twitter?.val || '';
      document.getElementById('fbInput').value = soc.fb?.val || '';

      // Local storage sync karein taaki posters me bhi naam aa jaye
      if (userState.name || userState.pic !== DEFAULT_GUEST_AVATAR) {
        localStorage.setItem('aestheticUser', JSON.stringify(userState));
      }
    }

    async function fetchPlanInfo(userId) {
      if (!sb || !userId) return;
      const { data } = await sb.from('subscriptions').select('plan, pro_until').eq('user_id', userId).maybeSingle();
      const badge = document.getElementById('planBadge');
      const info = document.getElementById('subExpiryInfo');

      if (data && Number(data.pro_until || 0) > Date.now()) {
        const days = Math.ceil((Number(data.pro_until) - Date.now()) / (1000 * 60 * 60 * 24));
        badge.innerText = `PRO PASS 👑`;
        badge.className = "inline-flex items-center gap-1 bg-amber-100 text-amber-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full mb-1 border border-amber-300";
        if (info) info.innerText = `Active • ${days} din bache hain`;
      } else {
        badge.innerText = `Free Plan`;
        badge.className = "inline-flex items-center gap-1 bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full mb-1";
        if (info) info.innerText = `Free Account (Upgrade to unlock all)`;
      }
    }

    // Google Login Function (Wahi same redirect jo Get Pro me chalta hai!)
    async function handleGoogleLogin() {
      if (!sb) {
        alert("Supabase initialize nahi ho paya!");
        return;
      }
      const btnText = document.getElementById('googleLoginBtnText');
      if (btnText) btnText.innerText = "Connecting to Google...";

      // Wahi working redirect URL jo app.js me hai
      const redirectUrl = `${window.location.origin}${baseUrl}`;

      const { error } = await sb.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: redirectUrl
        }
      });
      if (error) {
        alert("Google Login error: " + error.message);
        if (btnText) btnText.innerText = "Continue with Google";
      }
    }

    async function saveUserProfile() {
      const name = document.getElementById('nameInput').value.trim();
      if (!name) {
        alert("Kripya apna naam daalein!");
        return;
      }

      userState.name = name;
      userState.extra = document.getElementById('professionInput').value.trim() || "Poster Artist";
      userState.contact = document.getElementById('contactInput').value.trim() || "";

      userState.socials = {
        visible: document.getElementById('socialsToggle').checked,
        insta: { val: document.getElementById('instaInput').value.trim(), visible: true },
        twitter: { val: document.getElementById('twitterInput').value.trim(), visible: true },
        fb: { val: document.getElementById('fbInput').value.trim(), visible: true }
      };

      // 1. Local Storage me save karein
      localStorage.setItem('aestheticUser', JSON.stringify(userState));

      // 2. Supabase Cloud Account me permanently save karein!
      if (sb && currentUser) {
        try {
          await sb.auth.updateUser({
            data: {
              custom_name: userState.name,
              custom_extra: userState.extra,
              custom_contact: userState.contact,
              custom_pic: userState.pic,
              custom_socials: userState.socials
            }
          });
        } catch (err) {
          console.warn("Cloud save error:", err);
        }
      }

      alert("✅ Profile changes safaltapoorvak save ho gaye!");
      window.location.href = baseUrl;
    }

    function handleFileSelect(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          openCropper(e.target.result);
        };
        reader.readAsDataURL(file);
      }
      event.target.value = '';
    }

    function initManualCrop() {
      openCropper(userState.pic || DEFAULT_GUEST_AVATAR);
    }

    function openCropper(imageSrc) {
      const modal = document.getElementById('cropperModal');
      const image = document.getElementById('imageToCrop');
      if (image && modal) {
        image.src = imageSrc;
        modal.classList.remove('hidden');
        if (cropper) cropper.destroy();
        cropper = new window.Cropper(image, {
          aspectRatio: 1, viewMode: 1, dragMode: 'move', autoCropArea: 0.8,
          restore: false, guides: false, center: true, highlight: false,
          cropBoxMovable: false, cropBoxResizable: false, toggleDragModeOnDblclick: false,
          ready() { if (this.cropper) this.cropper.reset(); }
        });
      }
    }

    function cancelCrop() {
      document.getElementById('cropperModal')?.classList.add('hidden');
      if (cropper) { cropper.destroy(); cropper = null; }
    }

    function performCrop() {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas({ width: 300, height: 300 });
      const dataUrl = canvas.toDataURL('image/png');
      userState.pic = dataUrl;
      document.getElementById('profileAvatar').src = dataUrl;
      localStorage.setItem('aestheticUser', JSON.stringify(userState));
      document.getElementById('cropperModal')?.classList.add('hidden');
      cropper.destroy();
      cropper = null;
    }

    async function handleLogout() {
      const c = confirm("Kya aap logout karna chahte hain?");
      if (!c) return;

      try {
        if (sb) await sb.auth.signOut();
      } catch (e) {
        console.warn("Logout error:", e);
      }

      localStorage.removeItem('aestheticUser');
      localStorage.removeItem('postyFavorites');
      localStorage.removeItem('posty_ref');

      currentUser = null;
      updateAuthUI(null);
      alert("Aap logout ho chuke hain.");
    }

    async function handleDeleteAccount() {
      const c1 = confirm("⚠️ KYA AAP SACH ME APNA ACCOUNT DELETE KARNA CHAHTE HAIN?\n\nYeh action wapas nahi ho sakta. Aapka saara data permanent delete ho jayega.");
      if (!c1) return;

      const c2 = confirm("Aakhiri Baar Confirm Karein: Aapka Pro Pass aur Account sab delete ho jayega. Delete karein?");
      if (!c2) return;

      try {
        if (sb) {
          const { data: { session } } = await sb.auth.getSession();
          if (session?.user) {
            await sb.rpc('delete_user_account');
          }
          await sb.auth.signOut();
        }
      } catch (err) {
        console.warn("Delete RPC error:", err);
      }

      localStorage.removeItem('aestheticUser');
      localStorage.removeItem('postyFavorites');
      localStorage.removeItem('posty_ref');

      alert("Aapka account safaltapoorvak delete ho gaya hai.");
      window.location.href = baseUrl;
    }

    window.handleGoogleLogin = handleGoogleLogin;
    window.handleLogout = handleLogout;
    window.handleDeleteAccount = handleDeleteAccount;
    window.saveUserProfile = saveUserProfile;
    window.initManualCrop = initManualCrop;
    window.cancelCrop = cancelCrop;
    window.performCrop = performCrop;
  </script>
</Layout>
