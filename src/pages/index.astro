---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import SetupModal from '../components/SetupModal.astro';
import Navbar from '../components/Navbar.astro';
import EditorModal from '../components/EditorModal.astro';
import InstallBanner from '../components/InstallBanner.astro';

// public/posters folder se saari images apne aap read karega
const postersDir = path.join(process.cwd(), 'public', 'posters');
let localPosters = [];
if (fs.existsSync(postersDir)) {
  localPosters = fs.readdirSync(postersDir)
    .filter((file) => /\.(jpg|jpeg|png|webp|gif)$/i.test(file))
    .map((file) => `/posters/${file}`);
}
---

<Layout title="Aesthetic Poster Maker ✨">
  <SetupModal />
  <Navbar />

  <main id="mainContent" class="hidden">
    <div id="loadingGallery" class="flex flex-col items-center justify-center h-full w-full">
      <div class="cute-spinner"></div>
    </div>
    <div id="gallery" class="w-full" data-posters={JSON.stringify(localPosters)}></div>
    <div id="loadingMore" class="text-center p-8 hidden">
      <div class="cute-spinner mx-auto"></div>
    </div>
  </main>

  <InstallBanner />
  <EditorModal />

  <script src="../scripts/app.js"></script>
</Layout>
