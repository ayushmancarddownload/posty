---
import Layout from '../layouts/Layout.astro';
import SetupModal from '../components/SetupModal.astro';
import Navbar from '../components/Navbar.astro';
import EditorModal from '../components/EditorModal.astro';
import InstallBanner from '../components/InstallBanner.astro';
---

<Layout title="Aesthetic Poster Maker ✨">
  <SetupModal />
  <Navbar />

  <main id="mainContent" class="hidden">
    <div id="loadingGallery" class="flex flex-col items-center justify-center h-full w-full">
      <div class="cute-spinner"></div>
    </div>
    <div id="gallery" class="w-full"></div>
    <div id="loadingMore" class="text-center p-8 hidden">
      <div class="cute-spinner mx-auto"></div>
    </div>
  </main>

  <InstallBanner />
  <EditorModal />

  <script src="../scripts/app.js"></script>
</Layout>
